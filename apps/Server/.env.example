PORT=5050

# MongoDB connection string (MongoDB Atlas: Connect > Drivers). MONGO_URL
# (the first version's name) works too.
MONGO_URI=mongodb://127.0.0.1:27017/gadgethub
# Optional: the database to use when MONGO_URI doesn't name one.
MONGO_DB_NAME=

# Signs login tokens. Use a long random value; changing it signs everyone out.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET (the first version's name) works too.
JWT_SECRET_KEY=

# The web app's public URL, for links in emails and Paystack's return address.
# Also allowed by CORS. FRONTEND_URL works too.
CLIENT_URL=http://localhost:5173
# Extra browser origins allowed to call the API, comma separated.
CORS_ORIGINS=

# Proxies in front of the server (Render = 1). Leave empty locally.
TRUST_PROXY_HOPS=

# Cloudinary, for product photos (cloudinary.com > Settings > API Keys).
# CLOUD_NAME works too.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack (dashboard.paystack.com > Settings > API Keys & Webhooks). Without
# it, checkout offers pay on delivery only. Set the webhook URL there to
# https://<your-api>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=

# Doorstep delivery fee in naira (pickup is free). Default 3000.
DELIVERY_FEE=

# Where new-order alerts go. Leave empty for none.
ADMIN_NOTIFY_EMAIL=

# Logging: trace | debug | info | warn | error | fatal (default: debug in dev, info in production)
LOG_LEVEL=

# Emails: welcome, password resets and order updates.
# brevo (use in production) or gmail (local testing; Render's free plan
# blocks outgoing SMTP, so Gmail won't send from there). Unset: Brevo when
# BREVO_API_KEY is set, else Gmail.
EMAIL_PROVIDER=
# Brevo (brevo.com > SMTP & API > API keys). EMAIL_FROM must be a sender
# verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
# Gmail: the account to send from, and a Google app password for it
# (myaccount.google.com/apppasswords; needs 2-Step Verification on).
APP_EMAIL=
APP_PASSWORD=

# `npm run seed:admin` creates (or promotes) this admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
